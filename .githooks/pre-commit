#!/bin/sh
# Private terms in the staged changes, then the fast tests when Python changed.
# Switched on per clone with: git config core.hooksPath .githooks
. "$(dirname "$0")/find-python.sh"
"$py" "$root/tools/check_private.py" --staged || {
  echo "pre-commit: private terms in the staged changes (see above)." >&2; exit 1; }
if git diff --cached --name-only | grep -q '\.py$'; then
  "$py" -m pytest -m "not models" -q -x -p no:cacheprovider "$root/tests" >/dev/null 2>&1 || {
    echo "pre-commit: fast tests fail; run: \"$py\" -m pytest -m \"not models\" -x" >&2; exit 1; }
fi
